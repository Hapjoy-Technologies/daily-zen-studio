# Copy this file to .env.local and fill in your API base URL.
# The Lambda invoke URL looks like:
#   https://<id>.execute-api.<region>.amazonaws.com
NEXT_PUBLIC_API_BASE_URL=

# Optional. Override the GitHub Pages repo name baked into basePath.
# Defaults to "daily-zen-studio". Set to an empty string for a user/org root site
# (username.github.io) or a custom domain.
# NEXT_PUBLIC_BASE_PATH=daily-zen-studio
